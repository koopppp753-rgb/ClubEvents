<h1>Log In - ClubEvents</h1>

<%= form_with url: login_path, method: :post, local: true do |f| %>
  <div>
    <%= f.label :email, "Email" %><br>
    <%= f.email_field :email, required: true, autofocus: true %>
  </div>

  <div>
    <%= f.label :password, "Password" %><br>
    <%= f.password_field :password, required: true %>
  </div>

  <div>
    <%= f.submit "Log In" %>
  </div>
<% end %>

<p>Don't have an account? <%= link_to "Sign Up", signup_path %></p>
