<h1>قائمة الفعاليات</h1>

<table>
  <thead>
    <tr>
      <th>العنوان</th>
      <th>التاريخ</th>
      <th>الوصف</th>
    </tr>
  </thead>
  <tbody>
    <% @events.each do |event| %>
      <tr>
        <td><%= event.title %></td>
        <td><%= event.date %></td>
        <td><%= event.description %></td>
      </tr>
    <% end %>
  </tbody>
</table>
